X = read($X)
X_apply = read($X_apply)

iForestModel = outlierByIsolationForest(
  X = X,
  n_trees = $n_trees,
  subsampling_size = $subsampling_size,
  seed = $seed
)

M = as.matrix(iForestModel["model"])
actual_subsampling_size = as.scalar(iForestModel["subsampling_size"])

apply_start = time()
anomaly_scores = outlierByIsolationForestApply(
  iForestModel = iForestModel,
  X = X_apply
)
dml_apply_runtime = (time() - apply_start) / 1e9

# The training benchmark runs only for BASIC/SINGLE_NODE. Seven row counts are
# generated by repeatedly doubling benchmark_base_rows, and every size is
# trained benchmark_repetitions times. The checksum columns make every trained
# forest observable and prevent dead-code elimination from invalidating the
# timing. A per-call timer includes forest construction and SystemDS execution
# setup, but deliberately excludes one-off JVM and script-compilation startup.
dml_training_runtimes = matrix(0, rows = 1, cols = 5)
if ($run_benchmark == 1) {
  benchmark_X = read($benchmark_X)
  num_measurements = $benchmark_num_sizes * $benchmark_repetitions
  dml_training_runtimes = matrix(0, rows = num_measurements, cols = 5)

  for (size_id in 1:$benchmark_num_sizes) {
    benchmark_rows = as.integer($benchmark_base_rows * 2^(size_id - 1))
    X_benchmark_size = benchmark_X[1:benchmark_rows, ]

    for (repetition in 1:$benchmark_repetitions) {
      measurement_id = (size_id - 1) * $benchmark_repetitions + repetition
      repetition_seed = as.integer($benchmark_seed + repetition)

      training_start = time()
      benchmark_model = outlierByIsolationForest(
        X = X_benchmark_size,
        n_trees = $benchmark_n_trees,
        subsampling_size = $benchmark_subsampling_size,
        seed = repetition_seed
      )
      benchmark_M = as.matrix(benchmark_model["model"])
      model_checksum = sum(benchmark_M)
      model_squared_checksum = sum(benchmark_M * benchmark_M)
      training_runtime = (time() - training_start) / 1e9

      dml_training_runtimes[measurement_id, 1] = benchmark_rows
      dml_training_runtimes[measurement_id, 2] = repetition
      dml_training_runtimes[measurement_id, 3] = training_runtime
      dml_training_runtimes[measurement_id, 4] = model_checksum
      dml_training_runtimes[measurement_id, 5] = model_squared_checksum
    }
  }
}

# A repeated training run verifies deterministic seed handling. A second seed
# must produce a different model, proving that the seed is not simply ignored.
M_same_seed = M
M_different_seed = M
if ($check_seed == 1) {
  sameSeedModel = outlierByIsolationForest(
    X = X,
    n_trees = $n_trees,
    subsampling_size = $subsampling_size,
    seed = $seed
  )
  differentSeedModel = outlierByIsolationForest(
    X = X,
    n_trees = $n_trees,
    subsampling_size = $subsampling_size,
    seed = $seed + 1
  )
  M_same_seed = as.matrix(sameSeedModel["model"])
  M_different_seed = as.matrix(differentSeedModel["model"])
}

# This hand-built tree provides an implementation-independent oracle for the
# apply function, including the exact-threshold branch at x = 0.5.
reference_M = read($reference_model)
reference_X = read($reference_X)
referenceModel = list(
  model = reference_M,
  subsampling_size = 4
)
reference_anomaly_scores = outlierByIsolationForestApply(
  iForestModel = referenceModel,
  X = reference_X
)

write(anomaly_scores, $scores)
write(M, $model)
write(actual_subsampling_size, $subsampling_size_out)
write(M_same_seed, $same_seed_model)
write(M_different_seed, $different_seed_model)
write(reference_anomaly_scores, $reference_scores)
write(dml_apply_runtime, $dml_apply_runtime)
write(dml_training_runtimes, $dml_training_runtimes, format = "mm")

# The R reference implementation scores this exact serialized forest. Writing
# only for the extended BASIC/SINGLE_NODE check avoids unnecessary test I/O.
if ($check_seed == 1)
  write(M, $model_for_r, format = "mm")
