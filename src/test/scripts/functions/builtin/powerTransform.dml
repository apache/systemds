X = read($1);

if ($5 == "default") {
    [Y, lambdas, means, scales] = powerTransform(X=X);
    standardize = TRUE;
}
else {
    standardize = as.boolean($6);
    [Y, lambdas, means, scales] = powerTransform(
        X=X,
        method=$5,
        standardize=standardize
    );
}

if (standardize) {
    state = rbind(means, scales);
}
else {
    assert(nrow(means) == 0 & ncol(means) == 0);
    assert(nrow(scales) == 0 & ncol(scales) == 0);
    state = matrix(0.0, rows=2, cols=ncol(X));
}

write(Y, $2);
write(lambdas, $3);
write(state, $4);
