X = read($1);
lambdas = read($2);
means = read($3);
scales = read($4);

if (!as.boolean($7)) {
    means = matrix(0.0, rows=0, cols=0);
    scales = matrix(0.0, rows=0, cols=0);
}

Y = powerTransformApply(X, lambdas, means, scales, $6);
write(Y, $5);
