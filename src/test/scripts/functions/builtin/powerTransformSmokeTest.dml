# Test matrix:
# - Column 1 contains negative, zero, and positive values.
# - Column 2 contains positively skewed values.
# - Column 3 is constant.
X = matrix(
  "-2 1 5
   -1 1 5
    0 2 5
    1 3 5
    2 6 5
    4 12 5",
  rows=6,
  cols=3
)

print("Input X:")
print(toString(X, rows=6, cols=3, decimal=6))


# ------------------------------------------------------------------
# Test 1: Call powerTransformApply directly with lambda = 1
# ------------------------------------------------------------------

identityLambdas = matrix("1 1 1", rows=1, cols=3)
emptyStats = matrix(0.0, rows=0, cols=0)

YIdentity = powerTransformApply(
  X=X,
  lambdas=identityLambdas,
  means=emptyStats,
  scales=emptyStats
)

print("Apply result with lambda = 1:")
print(toString(YIdentity, rows=6, cols=3, decimal=6))

# Yeo-Johnson with lambda = 1 should leave all values unchanged.
identityError = max(abs(YIdentity - X))

print("Maximum identity error: " + identityError)

assert(identityError < 1e-10)


# ------------------------------------------------------------------
# Test 2: Estimate lambdas, transform X, and standardize by default
# ------------------------------------------------------------------

[Y, lambdas, means, scales] = powerTransform(X=X)

print("Estimated lambdas:")
print(toString(lambdas, rows=1, cols=3, decimal=6))

print("Transformed Y:")
print(toString(Y, rows=6, cols=3, decimal=6))


# ------------------------------------------------------------------
# Basic checks
# ------------------------------------------------------------------

# Output dimensions must match the input dimensions.
assert(nrow(Y) == nrow(X))
assert(ncol(Y) == ncol(X))

# There must be one lambda for each input column.
assert(nrow(lambdas) == 1)
assert(ncol(lambdas) == ncol(X))

# Standardization must return one mean and scale per input column.
assert(nrow(means) == 1)
assert(ncol(means) == ncol(X))
assert(nrow(scales) == 1)
assert(ncol(scales) == ncol(X))

# The constant third column should use lambda = 1.
constantLambda = as.scalar(lambdas[1,3])
assert(abs(constantLambda - 1.0) < 1e-10)

# Results should not contain invalid numerical values.
assert(sum(is.nan(Y)) == 0)
assert(sum(is.infinite(Y)) == 0)

assert(sum(is.nan(lambdas)) == 0)
assert(sum(is.infinite(lambdas)) == 0)

# Reapplying the fitted state must reproduce the fitted output.
YReapplied = powerTransformApply(X, lambdas, means, scales, "yeo-johnson")
assert(max(abs(Y - YReapplied)) < 1e-10)

# Standardized nonconstant columns must have zero mean and unit population variance.
standardizedMeans = colMeans(Y)
standardizedScales = sqrt(colSums(Y^2) / nrow(Y))
assert(max(abs(standardizedMeans)) < 1e-10)
assert(abs(as.scalar(standardizedScales[1,1]) - 1.0) < 1e-10)
assert(abs(as.scalar(standardizedScales[1,2]) - 1.0) < 1e-10)
assert(max(abs(Y[,3])) < 1e-10)


# ------------------------------------------------------------------
# Test 3: Disable standardization and select Yeo-Johnson explicitly
# ------------------------------------------------------------------

[YRaw, rawLambdas, rawMeans, rawScales] = powerTransform(
  X,
  "yeo-johnson",
  FALSE
)

assert(nrow(rawMeans) == 0)
assert(ncol(rawMeans) == 0)
assert(nrow(rawScales) == 0)
assert(ncol(rawScales) == 0)

YRawReapplied = powerTransformApply(
  X,
  rawLambdas,
  matrix(0.0, rows=0, cols=0),
  matrix(0.0, rows=0, cols=0),
  "yeo-johnson"
)
assert(max(abs(YRaw - YRawReapplied)) < 1e-10)
assert(max(abs(rawLambdas - lambdas)) < 1e-10)


# ------------------------------------------------------------------
# Test 4: Fit and apply Box-Cox on strictly positive input
# ------------------------------------------------------------------

XPositive = matrix(
  "0.5 1
    1.0 2
    2.0 3
    4.0 5
    8.0 9
   16.0 17",
  rows=6,
  cols=2
)

[YBoxCox, boxCoxLambdas, boxCoxMeans, boxCoxScales] = powerTransform(
  XPositive,
  "box-cox",
  TRUE
)

assert(nrow(YBoxCox) == nrow(XPositive))
assert(ncol(YBoxCox) == ncol(XPositive))
assert(nrow(boxCoxLambdas) == 1)
assert(ncol(boxCoxLambdas) == ncol(XPositive))
assert(sum(is.nan(YBoxCox)) == 0)
assert(sum(is.infinite(YBoxCox)) == 0)
assert(sum(is.nan(boxCoxLambdas)) == 0)
assert(sum(is.infinite(boxCoxLambdas)) == 0)

YBoxCoxReapplied = powerTransformApply(
  XPositive,
  boxCoxLambdas,
  boxCoxMeans,
  boxCoxScales,
  "box-cox"
)
assert(max(abs(YBoxCox - YBoxCoxReapplied)) < 1e-10)

boxCoxStandardizedMeans = colMeans(YBoxCox)
boxCoxStandardizedScales = sqrt(colSums(YBoxCox^2) / nrow(YBoxCox))
assert(max(abs(boxCoxStandardizedMeans)) < 1e-10)
assert(max(abs(boxCoxStandardizedScales - 1.0)) < 1e-10)

print("powerTransform smoke test passed.")
