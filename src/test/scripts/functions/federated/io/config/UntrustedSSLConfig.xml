<root>
    <!-- Coordinator side only: trusts an authority unrelated to the one that signed the worker
         certificate, therefore the worker has to be rejected. -->
    <sysds.local.spark.number.threads>2</sysds.local.spark.number.threads>
    <sysds.federated.ssl>true</sysds.federated.ssl>
    <sysds.federated.ssl.trust>src/test/resources/cert/untrusted-ca-cert.pem</sysds.federated.ssl.trust>
    <sysds.federated.timeout>128</sysds.federated.timeout>
</root>
